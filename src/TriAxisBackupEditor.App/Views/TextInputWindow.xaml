<Window x:Class="TriAxisBackupEditor.App.Views.TextInputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource AppWindow}"
        Width="520" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="20">
        <TextBlock x:Name="LabelText" Style="{StaticResource Label}" TextWrapping="Wrap" />
        <TextBox x:Name="ValueBox" Margin="0,4,0,0" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Cancelar" IsCancel="True" Padding="16,7" />
            <Button Content="OK" IsDefault="True" Style="{StaticResource AccentButton}" Click="Ok_Click" Padding="22,7" Margin="0" />
        </StackPanel>
    </StackPanel>
</Window>
