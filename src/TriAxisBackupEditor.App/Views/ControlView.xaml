<UserControl x:Class="TriAxisBackupEditor.App.Views.ControlView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:TriAxisBackupEditor.App.Controls"
             Focusable="True" PreviewKeyDown="OnPreviewKeyDown" IsVisibleChanged="OnIsVisibleChanged">



    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">

            <!-- Configuração e ativação -->
            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <Button Content="{Binding ActiveButtonText}" Command="{Binding ToggleActiveCommand}" Padding="22,12" FontSize="15" MinWidth="240">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource AccentButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource OkBrush}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource OkBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <TextBlock Style="{StaticResource Muted}" Margin="0,8,0,0" MaxWidth="260" FontSize="11.5"
                                   Text="Usa o MIDI OUT da aba Conexão. Envia só Program Change e CC: nada é gravado na memória do TriAxis." />
                    </StackPanel>
                    <WrapPanel Grid.Column="2" IsEnabled="{Binding CanEditSetup}" VerticalAlignment="Center">
                        <StackPanel Margin="0,0,20,8" Width="140">
                            <TextBlock Style="{StaticResource Label}" Text="Canal MIDI do TriAxis" />
                            <ComboBox ItemsSource="{Binding Channels}" SelectedItem="{Binding Channel}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,20,8" Width="130">
                            <TextBlock Style="{StaticResource Label}" Text="Pedais por banco" />
                            <ComboBox ItemsSource="{Binding BankSizes}" SelectedItem="{Binding BankSize}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,20,8" Width="300">
                            <TextBlock Style="{StaticResource Label}" Text="Entrada de controle (pedaleira/controlador no PC)" />
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="↻" Command="{Binding RefreshInputsCommand}" Margin="6,0,0,0" Padding="10,5" ToolTip="Atualizar lista" />
                                <ComboBox ItemsSource="{Binding InputOptions}" SelectedItem="{Binding SelectedInput}" />
                            </DockPanel>
                        </StackPanel>
                        <CheckBox Content="Repassar Program Change da entrada ao TriAxis" IsChecked="{Binding ForwardProgramChanges}" VerticalAlignment="Bottom" Margin="0,0,0,12" />
                    </WrapPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource StatusBanner}" Tag="{Binding StatusKind}" Margin="0,0,0,12">
                <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" />
            </Border>

            <!-- Pedaleira -->
            <Viewbox Stretch="Uniform" MaxHeight="440" HorizontalAlignment="Left" Margin="0,0,0,12">
                <Border CornerRadius="8" BorderBrush="#FF000000" BorderThickness="2" Padding="20">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#FF2E2E2E" Offset="0" />
                            <GradientStop Color="#FF171717" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackPanel Orientation="Horizontal">

                        <!-- Banco e programa -->
                        <StackPanel Width="190" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="BANCO" Foreground="#FFF2F2F2" FontFamily="Arial" FontWeight="Bold" HorizontalAlignment="Center" />
                            <Border Background="#FF0A0202" BorderBrush="#FF000000" BorderThickness="2" CornerRadius="2" Padding="12,8" HorizontalAlignment="Center" Margin="0,6">
                                <c:SevenSegmentDisplay Text="{Binding BankDisplay}" Digits="2" Height="58" OffBrush="{StaticResource SegRedOff}">
                                    <c:SevenSegmentDisplay.RenderTransform>
                                        <SkewTransform AngleX="-6" />
                                    </c:SevenSegmentDisplay.RenderTransform>
                                    <c:SevenSegmentDisplay.Effect>
                                        <DropShadowEffect ShadowDepth="0" BlurRadius="10" Color="#FFFF2A1A" Opacity="0.6" />
                                    </c:SevenSegmentDisplay.Effect>
                                </c:SevenSegmentDisplay>
                            </Border>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Style="{StaticResource BigArrow}" Content="▼" Command="{Binding BankDownCommand}" Width="80" Margin="0,4,6,4" ToolTip="Banco anterior (↓ / PgDn)" />
                                <Button Style="{StaticResource BigArrow}" Content="▲" Command="{Binding BankUpCommand}" Width="80" Margin="0,4,0,4" ToolTip="Próximo banco (↑ / PgUp)" />
                            </StackPanel>

                            <TextBlock Text="PROGRAMA ENVIADO" Foreground="#FFF2F2F2" FontFamily="Arial" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,18,0,0" />
                            <Border Background="#FF0A0202" BorderBrush="#FF000000" BorderThickness="2" CornerRadius="2" Padding="12,8" HorizontalAlignment="Center" Margin="0,6">
                                <c:SevenSegmentDisplay Text="{Binding ProgramDisplay}" Digits="3" Height="58" OnBrush="{StaticResource SegGreen}" OffBrush="{StaticResource SegGreenOff}">
                                    <c:SevenSegmentDisplay.RenderTransform>
                                        <SkewTransform AngleX="-6" />
                                    </c:SevenSegmentDisplay.RenderTransform>
                                    <c:SevenSegmentDisplay.Effect>
                                        <DropShadowEffect ShadowDepth="0" BlurRadius="10" Color="#FF6CFF3A" Opacity="0.5" />
                                    </c:SevenSegmentDisplay.Effect>
                                </c:SevenSegmentDisplay>
                            </Border>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Style="{StaticResource BigArrow}" Content="−1" Command="{Binding ProgramDownCommand}" Width="80" Margin="0,4,6,4" ToolTip="Programa anterior (←)" />
                                <Button Style="{StaticResource BigArrow}" Content="+1" Command="{Binding ProgramUpCommand}" Width="80" Margin="0,4,0,4" ToolTip="Próximo programa (→)" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Pedais -->
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding BankRangeText}" Foreground="#FFB8B8B8" FontFamily="Arial" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,4" />
                            <ItemsControl ItemsSource="{Binding Pedals}" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="{Binding DataContext.PedalColumns, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource Footswitch}" Command="{Binding PressCommand}" ToolTip="{Binding KeyHint}">
                                            <Grid>
                                                <Ellipse HorizontalAlignment="Left" VerticalAlignment="Top">
                                                    <Ellipse.Style>
                                                        <Style TargetType="Ellipse" BasedOn="{StaticResource PedalLed}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsLit}" Value="True">
                                                                    <Setter Property="Fill" Value="{StaticResource LedRedBrush}" />
                                                                    <Setter Property="Effect">
                                                                        <Setter.Value>
                                                                            <DropShadowEffect ShadowDepth="0" BlurRadius="14" Color="#FFFF2A1A" Opacity="0.9" />
                                                                        </Setter.Value>
                                                                    </Setter>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Ellipse.Style>
                                                </Ellipse>
                                                <TextBlock Text="{Binding Number}" HorizontalAlignment="Right" VerticalAlignment="Top" FontSize="28" FontWeight="Bold" FontFamily="Arial" Foreground="#FFF2F2F2" Margin="0,-6,4,0" />
                                                <Ellipse Style="{StaticResource MetalCap}" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,10,0,0" />
                                                <TextBlock Text="{Binding ProgramText}" HorizontalAlignment="Center" VerticalAlignment="Bottom" FontFamily="Arial" FontWeight="Bold" FontSize="12" Foreground="{StaticResource AccentBrush}" />
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- Botões CC -->
                        <StackPanel VerticalAlignment="Center" Margin="16,0,0,0" Width="190">
                            <TextBlock Text="BOTÕES CC" Foreground="#FFF2F2F2" FontFamily="Arial" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,6" />
                            <ItemsControl ItemsSource="{Binding CcButtons}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding ToggleCommand}" Focusable="False" Margin="0,5" Padding="10,10" HorizontalContentAlignment="Stretch">
                                            <DockPanel Width="150">
                                                <Ellipse DockPanel.Dock="Left" Width="14" Height="14" Stroke="Black" Margin="0,0,10,0">
                                                    <Ellipse.Style>
                                                        <Style TargetType="Ellipse">
                                                            <Setter Property="Fill" Value="#FF0C2409" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsOn}" Value="True">
                                                                    <Setter Property="Fill" Value="{StaticResource SegGreen}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Ellipse.Style>
                                                </Ellipse>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding Controller, StringFormat='CC {0}'}" Foreground="{StaticResource MutedBrush}" FontSize="11" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            </DockPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Viewbox>

            <!-- Monitor, entradas e botões CC -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource H2}" Text="Monitor MIDI" />
                            <TextBlock Style="{StaticResource Label}" Text="Último envio ao TriAxis" />
                            <TextBlock Style="{StaticResource Mono}" Text="{Binding LastSent}" Margin="0,0,0,8" />
                            <TextBlock Style="{StaticResource Label}" Text="Última mensagem da entrada de controle" />
                            <TextBlock Style="{StaticResource Mono}" Text="{Binding LastInput}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource H2}" Text="Atalhos de teclado (com esta aba aberta)" />
                            <TextBlock Style="{StaticResource Mono}" Foreground="{StaticResource MutedBrush}"
                                       Text="1 … 9, 0      pedais 1 … 10 (teclado numérico também)&#x0a;↑ / PgUp      próximo banco&#x0a;↓ / PgDn      banco anterior&#x0a;→ / ←         programa +1 / −1" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource H2}" Text="Botões CC (avançado)" />
                            <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,8"
                                       Text="Atenção: o TriAxis NÃO troca de canal (Rhythm/Lead), FX Loop nem switches por CC. Isso é feito pelos programas (Program Change): cada timbre guarda o seu modo, o loop e os switches. O CC do TriAxis só move os 9 botões de timbre (Gain, Treble...) e só no número de controle que você atribuiu a cada um no painel (SHIFT 3 vezes). Cada botão abaixo alterna CC = 127 / 0 no canal acima." />
                            <ItemsControl ItemsSource="{Binding CcButtons}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,0,0,6">
                                            <TextBox DockPanel.Dock="Right" Width="70" Text="{Binding Controller, UpdateSourceTrigger=LostFocus}" ToolTip="Número do CC (0–127)" Margin="8,0,0,0" />
                                            <TextBox Text="{Binding Label, UpdateSourceTrigger=LostFocus}" ToolTip="Nome exibido no botão" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Style="{StaticResource H2}" Text="Entradas MIDI (aprender)" />
                        <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,10"
                                   Text="Escolha uma entrada de controle, ative o modo controle, clique em &quot;Aprender&quot; e pise no pedal (ou mexa no botão) do seu controlador. Program Change, CC e notas podem ser usados." />
                        <ItemsControl ItemsSource="{Binding Bindings}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding TriggerText}" Style="{StaticResource Mono}" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
                                        <Button Grid.Column="2" Command="{Binding LearnCommand}" Padding="10,4" Margin="6,0,6,0" Focusable="False">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                    <Setter Property="Content" Value="Aprender" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsLearning}" Value="True">
                                                            <Setter Property="Content" Value="Aguardando..." />
                                                            <Setter Property="BorderBrush" Value="{StaticResource WarnBrush}" />
                                                            <Setter Property="Foreground" Value="{StaticResource WarnBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Grid.Column="3" Content="Limpar" Command="{Binding ClearCommand}" Padding="10,4" Margin="0" Focusable="False" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
