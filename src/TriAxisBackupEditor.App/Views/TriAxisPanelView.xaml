<UserControl x:Class="TriAxisBackupEditor.App.Views.TriAxisPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:TriAxisBackupEditor.App.Controls"
             xmlns:app="clr-namespace:TriAxisBackupEditor.App">
    <!-- Frente do TriAxis desenhada em vetor. DataContext: EditorViewModel. Usada no Editor (avançado) e em Meus timbres (simples). -->
    <UserControl.Resources>
        <app:EnumEqualsConverter x:Key="EnumEquals" />

        <SolidColorBrush x:Key="LedGreen" Color="#FF7CFF2A" />
        <SolidColorBrush x:Key="LedYellow" Color="#FFFFD21A" />
        <SolidColorBrush x:Key="LedRed" Color="#FFFF2A1A" />
        <SolidColorBrush x:Key="SegRedOff" Color="#FF2E0B08" />
        <SolidColorBrush x:Key="SegGreen" Color="#FF6CFF3A" />
        <SolidColorBrush x:Key="SegGreenOff" Color="#FF0C2409" />

        <Style x:Key="PanelLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFF2F2F2" />
            <Setter Property="FontFamily" Value="Arial" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,7,0,5" />
        </Style>

        <Style x:Key="PanelSmall" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFD0D0D0" />
            <Setter Property="FontFamily" Value="Arial" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Botões ◄ ► do painel -->
        <Style x:Key="PanelArrow" TargetType="ButtonBase">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Margin" Value="3,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="#FFE0E0E0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ButtonBase">
                        <Border x:Name="Bd" CornerRadius="3" BorderBrush="#FF050505" BorderThickness="1">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#FF6A6A6A" Offset="0" />
                                    <GradientStop Color="#FF3C3C3C" Offset="0.5" />
                                    <GradientStop Color="#FF2A2A2A" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.7" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Geometry x:Key="ArrowLeft">M 7 0 L 0 5 L 7 10 Z</Geometry>
        <Geometry x:Key="ArrowRight">M 0 0 L 7 5 L 0 10 Z</Geometry>

        <!-- Janela do display de LED -->
        <Style x:Key="DisplayWindow" TargetType="Border">
            <Setter Property="Background" Value="#FF0A0202" />
            <Setter Property="BorderBrush" Value="#FF000000" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Padding" Value="10,7,6,7" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <!-- LED clicável (ToggleButton/RadioButton). Tag = cor acesa. -->
        <Style x:Key="Led" TargetType="ToggleButton">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid Background="Transparent">
                            <Ellipse Fill="#FF151515" Stroke="#FF000000" StrokeThickness="1.5" />
                            <Ellipse x:Name="Lit" Margin="2" Fill="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Visibility="Collapsed">
                                <Ellipse.Effect>
                                    <DropShadowEffect ShadowDepth="0" BlurRadius="12" Color="White" Opacity="0.55" />
                                </Ellipse.Effect>
                            </Ellipse>
                            <Ellipse x:Name="Hover" Stroke="{StaticResource AccentBrush}" StrokeThickness="1" Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Lit" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Hover" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="KeypadDigit" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFA8A8A8" />
            <Setter Property="FontFamily" Value="Arial" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="11" />
        </Style>

        <!-- Teclas cinza do painel (ENTR, EXIT, SHIFT, LOOP SW, MODE, PGM/CH) -->
        <Style x:Key="PanelKey" TargetType="ButtonBase">
            <Setter Property="Width" Value="56" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ButtonBase">
                        <Border x:Name="Bd" CornerRadius="3" BorderBrush="#FF050505" BorderThickness="1.5">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#FFC4C4C4" Offset="0" />
                                    <GradientStop Color="#FF8E8E8E" Offset="0.55" />
                                    <GradientStop Color="#FF6A6A6A" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="#FF151515"
                                              TextElement.FontFamily="Arial" TextElement.FontWeight="Bold" TextElement.FontSize="10.5" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.75" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Um parâmetro: display + rótulo + ◄ ► -->
        <DataTemplate x:Key="KnobTemplate">
            <StackPanel Width="112">
                <Grid HorizontalAlignment="Center">
                    <Border Style="{StaticResource DisplayWindow}" MouseWheel="KnobDisplay_MouseWheel" MouseLeftButtonUp="KnobDisplay_Click"
                            ToolTip="Clique para escolher o valor, ou use a roda do mouse">
                        <c:SevenSegmentDisplay Text="{Binding Display}" Digits="2" Height="46" OffBrush="{StaticResource SegRedOff}">
                            <c:SevenSegmentDisplay.RenderTransform>
                                <SkewTransform AngleX="-6" />
                            </c:SevenSegmentDisplay.RenderTransform>
                            <c:SevenSegmentDisplay.Effect>
                                <DropShadowEffect ShadowDepth="0" BlurRadius="10" Color="#FFFF2A1A" Opacity="0.6" />
                            </c:SevenSegmentDisplay.Effect>
                        </c:SevenSegmentDisplay>
                    </Border>
                    <Ellipse Width="7" Height="7" Fill="{StaticResource AccentBrush}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-3,-3,0"
                             ToolTip="Alterado em relação ao arquivo original"
                             Visibility="{Binding IsModified, Converter={StaticResource BoolToVis}}" />
                </Grid>
                <TextBlock Text="{Binding Label}" Style="{StaticResource PanelLabel}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Style="{StaticResource PanelArrow}" Command="{Binding DecrementCommand}" ToolTip="Diminuir">
                        <Path Data="{StaticResource ArrowLeft}" Fill="#FFE0E0E0" />
                    </Button>
                    <Button Style="{StaticResource PanelArrow}" Command="{Binding IncrementCommand}" ToolTip="Aumentar">
                        <Path Data="{StaticResource ArrowRight}" Fill="#FFE0E0E0" />
                    </Button>
                </StackPanel>
                <Grid HorizontalAlignment="Center" Width="88" Margin="0,3,0,0">
                    <TextBlock Text="{Binding KeyLeft}" Style="{StaticResource KeypadDigit}" HorizontalAlignment="Left" Margin="16,0,0,0" />
                    <TextBlock Text="{Binding KeyRight}" Style="{StaticResource KeypadDigit}" HorizontalAlignment="Right" Margin="0,0,16,0" />
                </Grid>
            </StackPanel>
        </DataTemplate>

        <Style x:Key="RackEar" TargetType="Border">
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#FF2A2A2A" Offset="0" />
                        <GradientStop Color="#FF3A3A3A" Offset="0.5" />
                        <GradientStop Color="#FF222222" Offset="1" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RackSlot" TargetType="Border">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="15" />
            <Setter Property="CornerRadius" Value="7.5" />
            <Setter Property="BorderBrush" Value="#FF6B5418" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#FFF3D27A" Offset="0" />
                        <GradientStop Color="#FFD3A43A" Offset="0.6" />
                        <GradientStop Color="#FF9C7621" Offset="1" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- ================= Frente do TriAxis (desenho vetorial fiel ao painel) ================= -->
    <Viewbox Stretch="Uniform">
        <Border Width="2110" Height="212" CornerRadius="3" BorderBrush="#FF000000" BorderThickness="2" SnapsToDevicePixels="True">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#FF3A3A3A" Offset="0" />
                    <GradientStop Color="#FF1E1E1E" Offset="0.05" />
                    <GradientStop Color="#FF161616" Offset="0.5" />
                    <GradientStop Color="#FF111111" Offset="0.95" />
                    <GradientStop Color="#FF060606" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="64" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="64" />
                </Grid.ColumnDefinitions>

                <!-- Orelhas do rack com fendas douradas -->
                <Border Style="{StaticResource RackEar}">
                    <Grid>
                        <Border Style="{StaticResource RackSlot}" VerticalAlignment="Top" Margin="0,30,0,0" />
                        <Border Style="{StaticResource RackSlot}" VerticalAlignment="Bottom" Margin="0,0,0,30" />
                    </Grid>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource RackEar}">
                    <Grid>
                        <Border Style="{StaticResource RackSlot}" VerticalAlignment="Top" Margin="0,30,0,0" />
                        <Border Style="{StaticResource RackSlot}" VerticalAlignment="Bottom" Margin="0,0,0,30" />
                    </Grid>
                </Border>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center"
                            IsEnabled="{Binding HasDump}">

                    <!-- COPY / ENTR / EXIT -->
                    <StackPanel Width="76" VerticalAlignment="Center" Margin="0,0,4,0">
                        <TextBlock Text="COPY" Style="{StaticResource KeypadDigit}" HorizontalAlignment="Center" FontSize="9" Margin="0,0,0,3" />
                        <Button Style="{StaticResource PanelKey}" Content="ENTR" Command="{Binding SaveAsNewCommand}"
                                ToolTip="ENTR — no TriAxis grava o preset. Aqui: Salvar como novo .syx (o arquivo original não muda)." />
                        <Button Style="{StaticResource PanelKey}" Content="EXIT" Margin="0,30,0,0" Command="{Binding RevertPresetCommand}"
                                ToolTip="EXIT — no TriAxis sai da edição sem gravar. Aqui: desfaz as mudanças deste preset." />
                    </StackPanel>

                    <!-- PRESET -->
                    <StackPanel Width="112">
                        <Border Style="{StaticResource DisplayWindow}" MouseWheel="PresetDisplay_MouseWheel" ToolTip="Preset em edição (roda do mouse muda)">
                            <c:SevenSegmentDisplay Text="{Binding PresetDisplay}" Digits="2" Height="46" OffBrush="{StaticResource SegRedOff}">
                                <c:SevenSegmentDisplay.RenderTransform>
                                    <SkewTransform AngleX="-6" />
                                </c:SevenSegmentDisplay.RenderTransform>
                                <c:SevenSegmentDisplay.Effect>
                                    <DropShadowEffect ShadowDepth="0" BlurRadius="10" Color="#FFFF2A1A" Opacity="0.6" />
                                </c:SevenSegmentDisplay.Effect>
                            </c:SevenSegmentDisplay>
                        </Border>
                        <TextBlock Text="PRESET" Style="{StaticResource PanelLabel}" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Style="{StaticResource PanelArrow}" Command="{Binding PresetPrevCommand}" ToolTip="Preset anterior (no modo PGM/CH: muda o preset do programa)">
                                <Path Data="{StaticResource ArrowLeft}" Fill="#FFE0E0E0" />
                            </Button>
                            <Button Style="{StaticResource PanelArrow}" Command="{Binding PresetNextCommand}" ToolTip="Próximo preset (no modo PGM/CH: muda o preset do programa)">
                                <Path Data="{StaticResource ArrowRight}" Fill="#FFE0E0E0" />
                            </Button>
                        </StackPanel>
                        <TextBlock Text=" " Style="{StaticResource KeypadDigit}" Margin="0,3,0,0" />
                    </StackPanel>

                    <!-- PROGRAM / CHANNEL -->
                    <StackPanel Width="176" Margin="4,0,0,0">
                        <Border Style="{StaticResource DisplayWindow}" MouseWheel="ProgramDisplay_MouseWheel" ToolTip="{Binding ProgramInfo}">
                            <c:SevenSegmentDisplay Text="{Binding ProgramDisplay}" Digits="3" Height="46" OnBrush="{StaticResource SegGreen}" OffBrush="{StaticResource SegGreenOff}">
                                <c:SevenSegmentDisplay.RenderTransform>
                                    <SkewTransform AngleX="-6" />
                                </c:SevenSegmentDisplay.RenderTransform>
                                <c:SevenSegmentDisplay.Effect>
                                    <DropShadowEffect ShadowDepth="0" BlurRadius="10" Color="#FF6CFF3A" Opacity="0.5" />
                                </c:SevenSegmentDisplay.Effect>
                            </c:SevenSegmentDisplay>
                        </Border>
                        <TextBlock Text="PROGRAM / CHANNEL" Style="{StaticResource PanelLabel}" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Style="{StaticResource PanelArrow}" Command="{Binding ProgramPrevCommand}" ToolTip="Program Change anterior">
                                <Path Data="{StaticResource ArrowLeft}" Fill="#FFE0E0E0" />
                            </Button>
                            <Button Style="{StaticResource PanelArrow}" Command="{Binding ProgramNextCommand}" ToolTip="Próximo Program Change">
                                <Path Data="{StaticResource ArrowRight}" Fill="#FFE0E0E0" />
                            </Button>
                            <ToggleButton Style="{StaticResource PanelKey}" Width="58" Height="26" Margin="4,0,0,0" IsChecked="{Binding AssignMode}"
                                          ToolTip="PGM/CH — ligado: as setas de PRESET definem qual preset este Program Change chama">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="6" Height="6" Margin="0,0,3,0" VerticalAlignment="Center">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="#FF3A1010" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding AssignMode}" Value="True">
                                                        <Setter Property="Fill" Value="{StaticResource LedRed}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock Text="PGM/CH" FontSize="8.5" VerticalAlignment="Center" />
                                </StackPanel>
                            </ToggleButton>
                        </StackPanel>
                        <TextBlock Text=" " Style="{StaticResource KeypadDigit}" Margin="0,3,0,0" />
                    </StackPanel>

                    <!-- GAIN ... DYNAMIC VOICE -->
                    <ItemsControl ItemsSource="{Binding Knobs}" ItemTemplate="{StaticResource KnobTemplate}" Focusable="False" Margin="6,0,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <!-- SHIFT / LOOP SW / MODE + identificação -->
                    <StackPanel Width="250" VerticalAlignment="Center" Margin="16,0,6,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Style="{StaticResource PanelKey}" Content="SHIFT" Margin="5,0"
                                    ToolTip="SHIFT — no TriAxis dá acesso às segundas funções (ex.: SHIFT + PRESET ▼ envia o dump). Sem função no editor." />
                            <Button Style="{StaticResource PanelKey}" Margin="5,0" Command="{Binding ToggleLoopCommand}"
                                    ToolTip="LOOP SW — aqui liga/desliga o FX LOOP do preset">
                                <TextBlock Text="LOOP&#x0a;SW" TextAlignment="Center" LineHeight="11" LineStackingStrategy="BlockLineHeight" />
                            </Button>
                            <Button Style="{StaticResource PanelKey}" Content="MODE" Margin="5,0" Command="{Binding NextModeCommand}"
                                    ToolTip="MODE — aqui passa para o próximo modo (Rhythm Green → … → Lead 2 Red)" />
                        </StackPanel>
                        <TextBlock Text="TriAxis" FontFamily="Times New Roman" FontSize="50" Foreground="#FFF4F4F4" HorizontalAlignment="Center" Margin="0,6,0,-6" />
                        <TextBlock Text="MESA/BOOGIE" FontFamily="Georgia" FontStyle="Italic" FontWeight="Bold" FontSize="15" Foreground="#FFF4F4F4" HorizontalAlignment="Center">
                            <TextBlock.RenderTransform>
                                <SkewTransform AngleX="-8" />
                            </TextBlock.RenderTransform>
                        </TextBlock>
                        <TextBlock Text="ALL TUBE PREAMPLIFIER" FontFamily="Arial" FontWeight="Bold" FontSize="9" Foreground="#FFCFCFCF" HorizontalAlignment="Center" Margin="0,4,0,0" />
                    </StackPanel>

                    <!-- Matriz de LEDs: modo + switches -->
                    <Grid VerticalAlignment="Center" Margin="4,0,0,0" ToolTip="{Binding ModeText}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="RHY" Style="{StaticResource PanelSmall}" />
                        <RadioButton Grid.Row="0" Grid.Column="1" GroupName="TriAxisMode" Style="{StaticResource Led}" Tag="{StaticResource LedGreen}" ToolTip="Rhythm Green"
                                     IsChecked="{Binding Mode, Converter={StaticResource EnumEquals}, ConverterParameter=RhythmGreen}" />
                        <RadioButton Grid.Row="0" Grid.Column="2" GroupName="TriAxisMode" Style="{StaticResource Led}" Tag="{StaticResource LedYellow}" ToolTip="Rhythm Yellow"
                                     IsChecked="{Binding Mode, Converter={StaticResource EnumEquals}, ConverterParameter=RhythmYellow}" />

                        <TextBlock Grid.Row="1" Text="LD1" Style="{StaticResource PanelSmall}" />
                        <RadioButton Grid.Row="1" Grid.Column="1" GroupName="TriAxisMode" Style="{StaticResource Led}" Tag="{StaticResource LedGreen}" ToolTip="Lead 1 Green"
                                     IsChecked="{Binding Mode, Converter={StaticResource EnumEquals}, ConverterParameter=Lead1Green}" />
                        <RadioButton Grid.Row="1" Grid.Column="2" GroupName="TriAxisMode" Style="{StaticResource Led}" Tag="{StaticResource LedYellow}" ToolTip="Lead 1 Yellow"
                                     IsChecked="{Binding Mode, Converter={StaticResource EnumEquals}, ConverterParameter=Lead1Yellow}" />
                        <RadioButton Grid.Row="1" Grid.Column="3" GroupName="TriAxisMode" Style="{StaticResource Led}" Tag="{StaticResource LedRed}" ToolTip="Lead 1 Red"
                                     IsChecked="{Binding Mode, Converter={StaticResource EnumEquals}, ConverterParameter=Lead1Red}" />

                        <TextBlock Grid.Row="2" Text="LD2" Style="{StaticResource PanelSmall}" />
                        <RadioButton Grid.Row="2" Grid.Column="1" GroupName="TriAxisMode" Style="{StaticResource Led}" Tag="{StaticResource LedGreen}" ToolTip="Lead 2 Green"
                                     IsChecked="{Binding Mode, Converter={StaticResource EnumEquals}, ConverterParameter=Lead2Green}" />
                        <RadioButton Grid.Row="2" Grid.Column="2" GroupName="TriAxisMode" Style="{StaticResource Led}" Tag="{StaticResource LedYellow}" ToolTip="Lead 2 Yellow"
                                     IsChecked="{Binding Mode, Converter={StaticResource EnumEquals}, ConverterParameter=Lead2Yellow}" />
                        <RadioButton Grid.Row="2" Grid.Column="3" GroupName="TriAxisMode" Style="{StaticResource Led}" Tag="{StaticResource LedRed}" ToolTip="Lead 2 Red"
                                     IsChecked="{Binding Mode, Converter={StaticResource EnumEquals}, ConverterParameter=Lead2Red}" />

                        <TextBlock Grid.Row="3" Text="SW" Style="{StaticResource PanelSmall}" />
                        <ToggleButton Grid.Row="3" Grid.Column="1" Style="{StaticResource Led}" Tag="{StaticResource LedRed}" IsChecked="{Binding Switch1}" ToolTip="{Binding Switch1Name}" />
                        <ToggleButton Grid.Row="3" Grid.Column="2" Style="{StaticResource Led}" Tag="{StaticResource LedRed}" IsChecked="{Binding Switch2}" ToolTip="{Binding Switch2Name}" />
                        <ToggleButton Grid.Row="3" Grid.Column="3" Style="{StaticResource Led}" Tag="{StaticResource LedRed}" IsChecked="{Binding Switch3}" ToolTip="{Binding Switch3Name}" />
                        <ToggleButton Grid.Row="3" Grid.Column="4" Style="{StaticResource Led}" Tag="{StaticResource LedRed}" IsChecked="{Binding Switch4}" ToolTip="{Binding Switch4Name}" />

                        <TextBlock Grid.Row="4" Grid.Column="1" Text="1" Style="{StaticResource PanelSmall}" HorizontalAlignment="Center" FontSize="10" />
                        <TextBlock Grid.Row="4" Grid.Column="2" Text="2" Style="{StaticResource PanelSmall}" HorizontalAlignment="Center" FontSize="10" />
                        <TextBlock Grid.Row="4" Grid.Column="3" Text="3" Style="{StaticResource PanelSmall}" HorizontalAlignment="Center" FontSize="10" />
                        <TextBlock Grid.Row="4" Grid.Column="4" Text="4" Style="{StaticResource PanelSmall}" HorizontalAlignment="Center" FontSize="10" />

                        <TextBlock Grid.Row="5" Grid.ColumnSpan="4" Text="FX LOOP" Style="{StaticResource PanelSmall}" HorizontalAlignment="Right" Margin="0,0,4,0" />
                        <ToggleButton Grid.Row="5" Grid.Column="4" Style="{StaticResource Led}" Tag="{StaticResource LedGreen}" IsChecked="{Binding FxLoop}" ToolTip="{Binding FxLoopName}" />
                    </Grid>

                    <!-- OUTPUT (decorativo: o volume de saída não faz parte do preset) -->
                    <StackPanel VerticalAlignment="Center" Margin="22,0,8,0" ToolTip="OUTPUT — volume de saída do aparelho; não é gravado nos presets.">
                        <TextBlock Text="OUTPUT" Style="{StaticResource PanelSmall}" HorizontalAlignment="Center" />
                        <Canvas Width="124" Height="118">
                            <TextBlock Canvas.Left="20" Canvas.Top="91" Text="0" Style="{StaticResource KeypadDigit}" FontSize="10" />
                            <TextBlock Canvas.Left="7" Canvas.Top="70" Text="1" Style="{StaticResource KeypadDigit}" FontSize="10" />
                            <TextBlock Canvas.Left="5" Canvas.Top="45" Text="2" Style="{StaticResource KeypadDigit}" FontSize="10" />
                            <TextBlock Canvas.Left="14" Canvas.Top="22" Text="3" Style="{StaticResource KeypadDigit}" FontSize="10" />
                            <TextBlock Canvas.Left="33" Canvas.Top="7" Text="4" Style="{StaticResource KeypadDigit}" FontSize="10" />
                            <TextBlock Canvas.Left="58" Canvas.Top="1" Text="5" Style="{StaticResource KeypadDigit}" FontSize="10" />
                            <TextBlock Canvas.Left="83" Canvas.Top="7" Text="6" Style="{StaticResource KeypadDigit}" FontSize="10" />
                            <TextBlock Canvas.Left="102" Canvas.Top="22" Text="7" Style="{StaticResource KeypadDigit}" FontSize="10" />
                            <TextBlock Canvas.Left="111" Canvas.Top="45" Text="8" Style="{StaticResource KeypadDigit}" FontSize="10" />
                            <TextBlock Canvas.Left="109" Canvas.Top="70" Text="9" Style="{StaticResource KeypadDigit}" FontSize="10" />
                            <TextBlock Canvas.Left="93" Canvas.Top="91" Text="10" Style="{StaticResource KeypadDigit}" FontSize="10" />
                            <Ellipse Canvas.Left="27" Canvas.Top="26" Width="70" Height="70" Stroke="#FF000000" StrokeThickness="2">
                                <Ellipse.Fill>
                                    <RadialGradientBrush GradientOrigin="0.4,0.3">
                                        <GradientStop Color="#FF4A4A4A" Offset="0" />
                                        <GradientStop Color="#FF1A1A1A" Offset="0.7" />
                                        <GradientStop Color="#FF050505" Offset="1" />
                                    </RadialGradientBrush>
                                </Ellipse.Fill>
                                <Ellipse.Effect>
                                    <DropShadowEffect ShadowDepth="3" BlurRadius="6" Opacity="0.7" />
                                </Ellipse.Effect>
                            </Ellipse>
