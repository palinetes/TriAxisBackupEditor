<UserControl x:Class="TriAxisBackupEditor.App.Views.Simple.SimpleTimbresView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:TriAxisBackupEditor.App.Views">

    <Grid Margin="28,16,28,20">
        <!-- Sem backup ainda -->
        <Border Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="32,28" VerticalAlignment="Top" MaxWidth="760" HorizontalAlignment="Left"
                Visibility="{Binding HasDump, Converter={StaticResource InverseBoolToVis}}">
            <StackPanel>
                <TextBlock Text="Primeiro, vamos ler os timbres do seu TriAxis" Style="{StaticResource PageTitle}" FontSize="22" />
                <TextBlock Text="O programa precisa de uma cópia da memória do TriAxis para mostrar e ajustar os timbres. Leva menos de um minuto."
                           Style="{StaticResource Lead}" Margin="0,8,0,20" />
                <Button Content="Guardar a memória do TriAxis" Command="{Binding MakeBackupCommand}" Style="{StaticResource BigAccentButton}" HorizontalAlignment="Left" />
            </StackPanel>
        </Border>

        <Grid Visibility="{Binding HasDump, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Painel do TriAxis -->
            <views:TriAxisPanelView DataContext="{Binding Editor}" MaxHeight="280" Margin="0,0,0,18" />

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Lista dos 90 timbres -->
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Seus 90 timbres" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10" />
                    <ListBox Style="{StaticResource BigList}" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}" VirtualizingPanel.IsVirtualizing="True">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Label}" FontSize="15" TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>

                <!-- Timbre atual e ações -->
                <StackPanel Grid.Column="2">
                    <Border Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="26,22">
                        <StackPanel>
                            <TextBlock Text="{Binding CurrentName}" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="Ajuste os valores no painel acima: clique nas setas ◄ ►, gire a roda do mouse sobre um display ou clique nele para escolher o valor. Os LEDs da direita trocam o canal (Rhythm, Lead 1, Lead 2)."
                                       Style="{StaticResource Lead}" Margin="0,8,0,16" />
                            <WrapPanel>
                                <Button Content="Dar nome a este timbre" Command="{Binding RenameCommand}" Style="{StaticResource BigButton}" Margin="0,0,10,10" />
                                <Button Content="Desfazer mudanças" Command="{Binding UndoCommand}" Style="{StaticResource BigButton}" Margin="0,0,10,10" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="26,22" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock FontSize="16" TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Os timbres na tela são iguais aos do último backup." />
                                        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Editor.IsModified}" Value="True">
                                                <Setter Property="Text" Value="Você fez mudanças que ainda não foram para o TriAxis." />
                                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Button Content="Mandar para o TriAxis" Command="{Binding SendCommand}" Style="{StaticResource BigAccentButton}" HorizontalAlignment="Left" Margin="0,16,0,0" />
                            <TextBlock Style="{StaticResource Lead}" FontSize="12.5" Margin="0,14,0,0"
                                       Text="Edição em fase de teste: o programa sempre guarda o estado atual do TriAxis antes de mandar, então dá para voltar atrás pela página Backup." />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
