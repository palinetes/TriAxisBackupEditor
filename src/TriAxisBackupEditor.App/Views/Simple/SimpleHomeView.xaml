<UserControl x:Class="TriAxisBackupEditor.App.Views.Simple.SimpleHomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="40,32" MaxWidth="1040">

            <TextBlock Text="O que você quer fazer?" Style="{StaticResource PageTitle}" />
            <TextBlock Text="{Binding LastBackupText}" Style="{StaticResource Lead}" Margin="0,6,0,24" />

            <!-- Ainda não ligado -->
            <Border Style="{StaticResource StatusBanner}" Tag="Warning" Margin="0,0,0,24" Padding="18,14"
                    Visibility="{Binding IsConnected, Converter={StaticResource InverseBoolToVis}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Configurar ligação" Command="{Binding Shell.OpenWizardCommand}" Style="{StaticResource AccentButton}" Margin="12,0,0,0" />
                    <TextBlock Text="O TriAxis ainda não está ligado ao programa. Leva 2 minutos: o assistente mostra onde ligar cada cabo."
                               TextWrapping="Wrap" VerticalAlignment="Center" FontSize="14" />
                </DockPanel>
            </Border>

            <UniformGrid Columns="3">
                <!-- Meus timbres -->
                <Button Style="{StaticResource BigTile}" Command="{Binding Shell.GoTimbresCommand}" Margin="0,0,14,0">
                    <StackPanel>
                        <Path Data="{StaticResource IconSliders}" Stroke="{StaticResource AccentBrush}" StrokeThickness="2.4" Width="34" Height="34" Stretch="Uniform" HorizontalAlignment="Left" />
                        <TextBlock Text="Meus timbres" FontSize="20" FontWeight="SemiBold" Margin="0,16,0,6" />
                        <TextBlock Text="Ver e ajustar os 90 timbres no painel do TriAxis, com nomes que você escolhe." Style="{StaticResource Lead}" FontSize="14" />
                    </StackPanel>
                </Button>

                <!-- Backup -->
                <Button Style="{StaticResource BigTile}" Command="{Binding Shell.GoBackupCommand}" Margin="7,0">
                    <StackPanel>
                        <Path Data="{StaticResource IconShield}" Stroke="{StaticResource AccentBrush}" StrokeThickness="2.2" Width="34" Height="34" Stretch="Uniform" HorizontalAlignment="Left" />
                        <TextBlock Text="Backup" FontSize="20" FontWeight="SemiBold" Margin="0,16,0,6" />
                        <TextBlock Text="Guardar a memória do TriAxis no computador ou devolver um backup ao aparelho." Style="{StaticResource Lead}" FontSize="14" />
                    </StackPanel>
                </Button>

                <!-- Tocar -->
                <Button Style="{StaticResource BigTile}" Command="{Binding Shell.GoTocarCommand}" Margin="14,0,0,0">
                    <StackPanel>
                        <Path Data="{StaticResource IconPlay}" Stroke="{StaticResource AccentBrush}" StrokeThickness="2.2" Width="34" Height="34" Stretch="Uniform" HorizontalAlignment="Left" />
                        <TextBlock Text="Tocar" FontSize="20" FontWeight="SemiBold" Margin="0,16,0,6" />
                        <TextBlock Text="Trocar de canal e de banco pela tela ou pelo teclado, como uma pedaleira." Style="{StaticResource Lead}" FontSize="14" />
                    </StackPanel>
                </Button>
            </UniformGrid>

            <StackPanel Orientation="Horizontal" Margin="0,28,0,0">
                <Button Style="{StaticResource LinkButton}" Command="{Binding Shell.OpenWizardCommand}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconPlug}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0" />
                        <TextBlock Text="Refazer a configuração da ligação" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
