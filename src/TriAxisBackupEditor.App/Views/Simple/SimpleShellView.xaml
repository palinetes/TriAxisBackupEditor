<UserControl x:Class="TriAxisBackupEditor.App.Views.Simple.SimpleShellView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:TriAxisBackupEditor.App.ViewModels.Simple"
             xmlns:local="clr-namespace:TriAxisBackupEditor.App.Views.Simple">

    <UserControl.Resources>
        <DataTemplate DataType="{x:Type vm:SimpleHomeViewModel}"><local:SimpleHomeView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SetupWizardViewModel}"><local:SetupWizardView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SimpleTimbresViewModel}"><local:SimpleTimbresView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SimpleBackupViewModel}"><local:SimpleBackupView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SimpleTocarViewModel}"><local:SimpleTocarView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SafeSendViewModel}"><local:SafeSendView /></DataTemplate>
    </UserControl.Resources>

    <DockPanel>
        <!-- Voltar ao início + título da página (escondido na própria tela inicial) -->
        <Border DockPanel.Dock="Top" Padding="28,16,28,0" Visibility="{Binding IsHome, Converter={StaticResource InverseBoolToVis}}">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource LinkButton}" Command="{Binding GoHomeCommand}" FontSize="15">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconBack}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2.2"
                              Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="Início" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <TextBlock Text="/" Foreground="{StaticResource MutedBrush}" FontSize="15" Margin="8,0" VerticalAlignment="Center" />
                <TextBlock Text="{Binding CurrentPage.Title}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <ContentControl Content="{Binding CurrentPage}" Focusable="False" />
    </DockPanel>
</UserControl>
