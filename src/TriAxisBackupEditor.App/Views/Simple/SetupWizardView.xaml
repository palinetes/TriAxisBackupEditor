<UserControl x:Class="TriAxisBackupEditor.App.Views.Simple.SetupWizardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:TriAxisBackupEditor.App.Views.Simple">

    <UserControl.Resources>
        <!-- Mostra um passo só quando Step bate com Tag -->
        <Style x:Key="StepPanel" TargetType="StackPanel">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Value="True">
                    <DataTrigger.Binding>
                        <MultiBinding Converter="{StaticResource StepEquals}">
                            <Binding Path="StepNumber" />
                            <Binding Path="Tag" RelativeSource="{RelativeSource Self}" />
                        </MultiBinding>
                    </DataTrigger.Binding>
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Bolinha do indicador de passos -->
        <Style x:Key="StepDot" TargetType="Border">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="CornerRadius" Value="17" />
            <Setter Property="Background" Value="{StaticResource Panel2Brush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Style.Triggers>
                <DataTrigger Value="True">
                    <DataTrigger.Binding>
                        <MultiBinding Converter="{StaticResource StepReached}">
                            <Binding Path="StepNumber" />
                            <Binding Path="Tag" RelativeSource="{RelativeSource Self}" />
                        </MultiBinding>
                    </DataTrigger.Binding>
                    <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                    <Setter Property="TextElement.Foreground" Value="#FF15171B" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <DockPanel Margin="40,20,40,24">
        <!-- Indicador de passos -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,24">
            <Border Style="{StaticResource StepDot}" Tag="1"><TextBlock Text="1" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
            <TextBlock Text="Aparelho" Style="{StaticResource Lead}" Margin="8,0,18,0" VerticalAlignment="Center" />
            <Border Style="{StaticResource StepDot}" Tag="2"><TextBlock Text="2" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
            <TextBlock Text="Cabos" Style="{StaticResource Lead}" Margin="8,0,18,0" VerticalAlignment="Center" />
            <Border Style="{StaticResource StepDot}" Tag="3"><TextBlock Text="3" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
            <TextBlock Text="Primeiro backup" Style="{StaticResource Lead}" Margin="8,0,18,0" VerticalAlignment="Center" />
            <Border Style="{StaticResource StepDot}" Tag="4"><TextBlock Text="4" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
            <TextBlock Text="Teste" Style="{StaticResource Lead}" Margin="8,0,0,0" VerticalAlignment="Center" />
        </StackPanel>

        <!-- Rodapé: voltar / pular / próximo -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,20,0,0">
            <Button DockPanel.Dock="Left" Content="Voltar" Command="{Binding BackCommand}" Style="{StaticResource BigButton}" />
            <Button DockPanel.Dock="Right" Content="{Binding NextText}" Command="{Binding NextCommand}" Style="{StaticResource BigAccentButton}" Margin="0" />
            <Button DockPanel.Dock="Right" Content="Pular por agora" Command="{Binding SkipCommand}" Style="{StaticResource LinkButton}" Margin="0,0,16,0" VerticalAlignment="Center" FontSize="14" />
            <Border />
        </DockPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid MaxWidth="980" HorizontalAlignment="Left">

                <!-- ===== Passo 1: aparelho ===== -->
                <StackPanel Style="{StaticResource StepPanel}" Tag="1">
                    <TextBlock Text="Como o TriAxis vai se ligar ao computador?" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="Escolha o que você tem. Se não souber, é quase sempre um cabo USB-MIDI." Style="{StaticResource Lead}" Margin="0,6,0,18" />
                    <UniformGrid Columns="2" Margin="0,0,0,26">
                        <RadioButton Style="{StaticResource ChoiceCard}" IsChecked="{Binding UsesUsbCable}" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="Cabo USB-MIDI" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock Text="Um cabo com USB numa ponta e dois plugues redondos (MIDI) na outra." Style="{StaticResource Lead}" FontSize="14" Margin="0,4,0,0" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource ChoiceCard}" IsChecked="{Binding UsesAudioInterface}" Margin="8,0,0,0">
                            <StackPanel>
                                <TextBlock Text="Placa de áudio com MIDI" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock Text="Ex.: RME, Focusrite, Behringer, com conectores MIDI IN e OUT." Style="{StaticResource Lead}" FontSize="14" Margin="0,4,0,0" />
                            </StackPanel>
                        </RadioButton>
                    </UniformGrid>

                    <TextBlock Text="Qual destes é o seu aparelho?" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10" />
                    <ListBox Style="{StaticResource BigList}" ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" FontSize="16" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Border Style="{StaticResource StatusBanner}" Tag="Warning" Padding="16,12" Visibility="{Binding HasNoDevices, Converter={StaticResource BoolToVis}}">
                        <TextBlock TextWrapping="Wrap" FontSize="14"
                                   Text="Não encontrei nenhum aparelho MIDI. Conecte o cabo USB (ou ligue a placa de áudio) e espere alguns segundos: a lista se atualiza sozinha." />
                    </Border>
                </StackPanel>

                <!-- ===== Passo 2: cabos ===== -->
                <StackPanel Style="{StaticResource StepPanel}" Tag="2">
                    <TextBlock Text="Ligue os dois cabos assim" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="Os conectores MIDI ficam na parte de trás do TriAxis." Style="{StaticResource Lead}" Margin="0,6,0,22" />

                    <Viewbox HorizontalAlignment="Left" MaxWidth="900">
                        <Canvas Width="900" Height="250">
                            <!-- TriAxis (traseira) -->
                            <Border Canvas.Left="0" Canvas.Top="20" Width="320" Height="210" CornerRadius="8" Background="#FF101010" BorderBrush="#FF4A4A4A" BorderThickness="2">
                                <StackPanel Margin="16,12">
                                    <TextBlock Text="TriAxis (parte de trás)" Foreground="#FFE0E0E0" FontWeight="SemiBold" FontSize="15" />
                                    <StackPanel Orientation="Horizontal" Margin="0,30,0,0" HorizontalAlignment="Center">
                                        <StackPanel Margin="0,0,40,0">
                                            <Ellipse Width="58" Height="58" Fill="#FF2A2A2A" Stroke="{StaticResource AccentBrush}" StrokeThickness="3" />
                                            <TextBlock Text="MIDI OUT" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,8,0,0" />
                                        </StackPanel>
                                        <StackPanel>
                                            <Ellipse Width="58" Height="58" Fill="#FF2A2A2A" Stroke="#FF6CB4FF" StrokeThickness="3" />
                                            <TextBlock Text="MIDI IN" Foreground="#FF6CB4FF" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,8,0,0" />
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Computador / interface -->
                            <Border Canvas.Left="600" Canvas.Top="20" Width="300" Height="210" CornerRadius="8" Background="{StaticResource Panel2Brush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="2">
                                <StackPanel Margin="16,12">
                                    <TextBlock Text="Seu computador" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" FontSize="15" />
                                    <TextBlock Text="(pelo cabo USB-MIDI ou pela placa de áudio)" Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- Cabo 1: TriAxis OUT -> computador -->
                            <Path Data="M 128 110 C 300 60 450 60 600 90" Stroke="{StaticResource AccentBrush}" StrokeThickness="4" />
                            <Path Data="M 588 80 L 604 91 L 588 100" Stroke="{StaticResource AccentBrush}" StrokeThickness="4" />
                            <TextBlock Canvas.Left="345" Canvas.Top="4" Width="240" TextWrapping="Wrap" TextAlignment="Center" Text="Cabo 1: do MIDI OUT do TriAxis para o computador" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" FontSize="13" />

                            <!-- Cabo 2: computador -> TriAxis IN -->
                            <Path Data="M 600 170 C 450 210 330 210 228 150" Stroke="#FF6CB4FF" StrokeThickness="4" />
                            <Path Data="M 242 146 L 226 150 L 236 163" Stroke="#FF6CB4FF" StrokeThickness="4" />
                            <TextBlock Canvas.Left="345" Canvas.Top="206" Width="240" TextWrapping="Wrap" TextAlignment="Center" Text="Cabo 2: do computador para o MIDI IN do TriAxis" Foreground="#FF6CB4FF" FontWeight="SemiBold" FontSize="13" />
                        </Canvas>
                    </Viewbox>

                    <Border Background="{StaticResource PanelBrush}" CornerRadius="10" Padding="20,16" Margin="0,22,0,0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource BigText}" FontSize="15"
                                       Visibility="{Binding UsesUsbCable, Converter={StaticResource BoolToVis}}"
                                       Text="No cabo USB-MIDI, cada plugue tem uma etiqueta (IN ou OUT), e alguns fabricantes etiquetam ao contrário. Não se preocupe: se trocar, o próximo passo avisa e é só inverter os dois plugues." />
                            <TextBlock Style="{StaticResource BigText}" FontSize="15"
                                       Visibility="{Binding UsesAudioInterface, Converter={StaticResource BoolToVis}}"
                                       Text="Na placa de áudio: o MIDI OUT do TriAxis vai no MIDI IN da placa, e o MIDI OUT da placa vai no MIDI IN do TriAxis. Se tiver uma pedaleira ligada no TriAxis, desconecte-a durante a configuração." />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ===== Passo 3: primeiro backup ===== -->
                <StackPanel Style="{StaticResource StepPanel}" Tag="3">
                    <TextBlock Text="Vamos guardar seus timbres" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="Este passo testa a ligação e, de quebra, já guarda no computador tudo o que está no TriAxis. Nada é alterado no aparelho."
                               Style="{StaticResource Lead}" Margin="0,6,0,20" />
                    <local:CaptureCardView DataContext="{Binding FirstBackup}" />
                </StackPanel>

                <!-- ===== Passo 4: teste de envio ===== -->
                <StackPanel Style="{StaticResource StepPanel}" Tag="4">
                    <TextBlock Text="Último teste: o computador consegue mandar no TriAxis?" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="Vou pedir ao TriAxis para trocar de programa e você me diz se o display PROGRAM/CHANNEL mudou. Nenhum timbre é alterado. Com até 5 respostas, o programa descobre sozinho o número do seu TriAxis."
                               Style="{StaticResource Lead}" Margin="0,6,0,20" />

                    <Border Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="28,24">
                        <StackPanel>
                            <!-- Jeito mais fácil: o próprio TriAxis diz o número -->
                            <TextBlock Text="Jeito mais fácil: ouvir o TriAxis" Style="{StaticResource Lead}" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <TextBlock Text="Clique no botão e aperte uma seta de PROGRAM no painel do TriAxis. Ele mesmo avisa o número em que está. Nada é enviado a ele."
                                       Style="{StaticResource Lead}" FontSize="14" Margin="0,0,0,10" />
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,22">
                                <Button Content="Escutar o TriAxis" Command="{Binding ListenCommand}" Style="{StaticResource BigAccentButton}" />
                                <Button Content="Parar" Command="{Binding StopListenCommand}" Style="{StaticResource BigButton}" />
                            </StackPanel>

                            <TextBlock Text="Se não funcionar, teste mandando uma troca de programa:" Style="{StaticResource Lead}" FontSize="14" Margin="0,0,0,10" />
                            <Button Content="{Binding SendTestText}" Command="{Binding SendTestCommand}" Style="{StaticResource BigAccentButton}" HorizontalAlignment="Left"
                                    Visibility="{Binding TestSent, Converter={StaticResource InverseBoolToVis}}" />

                            <TextBlock Text="{Binding TestMessage}" Style="{StaticResource BigText}" Margin="0,18,0,0" Visibility="{Binding TestMessage, Converter={StaticResource NullToCollapsed}}" />

                            <StackPanel Orientation="Horizontal" Margin="0,16,0,0" Visibility="{Binding TestSent, Converter={StaticResource BoolToVis}}">
                                <Button Content="Sim, mudou" Command="{Binding YesCommand}" Style="{StaticResource BigAccentButton}" />
                                <Button Content="Não mudou" Command="{Binding NoCommand}" Style="{StaticResource BigButton}" />
                            </StackPanel>

                            <!-- Número manual, para quem já sabe -->
                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,24,0,0" Padding="0,16,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Já sabe o número do TriAxis?" Style="{StaticResource Lead}" FontSize="14" VerticalAlignment="Center" Margin="0,0,14,0" />
                                    <Button Content="−" Style="{StaticResource BigButton}" Padding="14,4" Click="ChannelDown_Click" />
                                    <TextBlock Text="{Binding Channel}" FontSize="22" FontWeight="Bold" Width="44" TextAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource AccentBrush}" />
                                    <Button Content="+" Style="{StaticResource BigButton}" Padding="14,4" Click="ChannelUp_Click" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</UserControl>
