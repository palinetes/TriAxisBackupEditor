<UserControl x:Class="TriAxisBackupEditor.App.Views.Simple.CaptureCardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- DataContext: CaptureCardViewModel -->
    <Border Background="{StaticResource PanelBrush}" BorderThickness="2" CornerRadius="12" Padding="28,24">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsSuccess}" Value="True">
                        <Setter Property="BorderBrush" Value="{StaticResource OkBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsFailed}" Value="True">
                        <Setter Property="BorderBrush" Value="{StaticResource WarnBrush}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <StackPanel>
            <DockPanel>
                <Path DockPanel.Dock="Left" Data="{StaticResource IconCheck}" Stroke="{StaticResource OkBrush}" StrokeThickness="3" Width="30" Height="30" Stretch="Uniform"
                      Margin="0,0,14,0" VerticalAlignment="Center" Visibility="{Binding IsSuccess, Converter={StaticResource BoolToVis}}" />
                <TextBlock Text="{Binding Title}" FontSize="21" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" />
            </DockPanel>
            <TextBlock Text="{Binding Detail}" Style="{StaticResource BigText}" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0"
                       Visibility="{Binding Detail, Converter={StaticResource NullToCollapsed}}" />

            <!-- Desenho das teclas SHIFT + PRESET ▼ -->
            <StackPanel Orientation="Horizontal" Margin="0,20,0,4" Visibility="{Binding ShowInstruction, Converter={StaticResource BoolToVis}}">
                <Border Width="92" Height="58" CornerRadius="5" BorderBrush="#FF050505" BorderThickness="2">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#FFD0D0D0" Offset="0" />
                            <GradientStop Color="#FF8A8A8A" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <TextBlock Text="SHIFT" Foreground="#FF151515" FontFamily="Arial" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="+" FontSize="34" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="18,0" VerticalAlignment="Center" />
                <Border Width="92" Height="58" CornerRadius="5" BorderBrush="#FF050505" BorderThickness="2">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#FF6A6A6A" Offset="0" />
                            <GradientStop Color="#FF2A2A2A" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Path Data="M 12 0 L 0 8 L 12 16 Z" Fill="#FFE0E0E0" HorizontalAlignment="Center" />
                        <TextBlock Text="PRESET" Foreground="#FFE0E0E0" FontFamily="Arial" FontWeight="Bold" FontSize="11" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
                <TextBlock Text="segure SHIFT e aperte a seta&#x0a;da esquerda do PRESET" Style="{StaticResource Lead}" VerticalAlignment="Center" Margin="22,0,0,0" />
            </StackPanel>

            <ProgressBar Value="{Binding Percent, Mode=OneWay}" Maximum="100" Height="16" Margin="0,18,0,0"
                         Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}" />

            <Border Background="{StaticResource WarnBgBrush}" CornerRadius="8" Padding="16,12" Margin="0,16,0,0"
                    Visibility="{Binding Hint, Converter={StaticResource NullToCollapsed}}">
                <TextBlock Text="{Binding Hint}" Style="{StaticResource BigText}" FontSize="15" Foreground="{StaticResource WarnBrush}" />
            </Border>

            <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                <Button Command="{Binding StartCommand}" Style="{StaticResource BigAccentButton}" Visibility="{Binding IsReady, Converter={StaticResource BoolToVis}}">
                    <Button.Content>
                        <TextBlock>
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="Começar" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsFailed}" Value="True">
                                            <Setter Property="Text" Value="Tentar de novo" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Button.Content>
                </Button>
                <Button Content="Cancelar" Command="{Binding CancelCommand}" Style="{StaticResource BigButton}" Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
